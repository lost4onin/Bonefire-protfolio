---
/**
 * Loading screen: small bonfire bottom-left, a thin ember progress line, rotating true-fact tips.
 * Inline HTML/CSS, hidden by default (no JS → never shown, never stuck).
 *
 * It only appears when a page has something to wait for: a script calls `window.__loader.expect()`
 * (M3: the 3D scene, driven by THREE.LoadingManager), then `.progress(0..1)` and `.done()`.
 * Shown only if the work takes > 400ms; hard cap 6s; Space or a click skips.
 * Emits `ff:loader` on document with detail 'done' | 'skipped' | 'timeout' (the scene can fall back).
 * Lives in WorldLayout. `preview` renders a static, always-visible copy for /lab.
 */
import Bonfire2D from './Bonfire2D.astro';
import KeyPrompt from '@/components/ui/KeyPrompt.astro';
import { loadingTips } from '@/data/tips';

interface Props {
  preview?: boolean;
}
const { preview = false } = Astro.props;
---

<div
  id={preview ? undefined : 'loader'}
  class:list={['loader', { preview }]}
  hidden={!preview}
  data-tips={JSON.stringify(loadingTips)}
>
  <div class="fire" aria-hidden="true"><Bonfire2D size={72} sword={false} /></div>
  <div class="body">
    <p class="tip" data-tip>{loadingTips[0]}</p>
    <div
      class="bar"
      role="progressbar"
      aria-label="Loading"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow={preview ? 60 : 0}
    >
      <span style={preview ? 'transform: scaleX(0.6)' : undefined}></span>
    </div>
  </div>
  <p class="skip"><KeyPrompt keys={['Space']} label="Skip" /></p>
</div>

<script>
  import { durationMs } from '@/lib/tokens';
  const SHOW_AFTER = 400; // ms: fast loads never flash a loader
  const HARD_CAP = 6000; // ms: then continue with whatever is ready (the scene's fallback)

  let showTimer = 0;
  let capTimer = 0;
  let tipTimer = 0;
  let pending = false;

  const el = () => document.getElementById('loader');

  function show() {
    const loader = el();
    if (!loader || !pending) return;
    loader.hidden = false;
    requestAnimationFrame(() => (loader.dataset.state = 'visible'));
    const tips: string[] = JSON.parse(loader.dataset.tips ?? '[]');
    const tip = loader.querySelector<HTMLElement>('[data-tip]')!;
    let i = 0;
    tipTimer = window.setInterval(() => {
      tip.classList.add('swap');
      setTimeout(() => {
        i = (i + 1) % tips.length;
        tip.textContent = tips[i] ?? '';
        tip.classList.remove('swap');
      }, durationMs('--dur-base'));
    }, durationMs('--dur-tip'));
  }

  function finish(reason: 'done' | 'skipped' | 'timeout' | 'reset') {
    clearTimeout(showTimer);
    clearTimeout(capTimer);
    clearInterval(tipTimer);
    const wasPending = pending;
    pending = false;
    const loader = el();
    if (loader && !loader.hidden) {
      loader.dataset.state = 'leaving';
      setTimeout(() => {
        loader.hidden = true;
        delete loader.dataset.state;
      }, durationMs('--dur-fade'));
    }
    if (wasPending && reason !== 'reset')
      document.dispatchEvent(new CustomEvent('ff:loader', { detail: reason }));
  }

  if (!window.__loaderBound) {
    window.__loaderBound = true;

    window.__loader = {
      expect() {
        if (pending) return;
        pending = true;
        showTimer = window.setTimeout(show, SHOW_AFTER);
        capTimer = window.setTimeout(() => finish('timeout'), HARD_CAP);
      },
      progress(value) {
        const bar = el()?.querySelector<HTMLElement>('.bar');
        if (!bar) return;
        const v = Math.min(1, Math.max(0, value));
        bar.querySelector('span')!.style.transform = `scaleX(${v})`;
        bar.setAttribute('aria-valuenow', String(Math.round(v * 100)));
      },
      done() {
        finish('done');
      },
    };

    const visible = () => pending && el()?.dataset.state === 'visible';
    document.addEventListener('keydown', (e) => {
      if (e.code === 'Space' && visible()) {
        e.preventDefault();
        finish('skipped');
      }
    });
    document.addEventListener('click', (e) => {
      if (visible() && el()?.contains(e.target as Node)) finish('skipped');
    });
    document.addEventListener('astro:before-swap', () => finish('reset'));
  }
</script>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: var(--z-loader);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: end;
    gap: var(--sp-5);
    padding: var(--sp-6) var(--gutter);
    background: var(--c-void);
    opacity: 0;
    transition: opacity var(--dur-fade) var(--ease-in-out);
  }
  .loader[hidden] {
    display: none;
  }
  .loader[data-state='visible'],
  .loader.preview {
    opacity: 1;
  }
  .loader.preview {
    position: relative;
    inset: auto;
    z-index: auto;
    min-height: 280px;
    border: var(--stroke) solid var(--c-line);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding-bottom: var(--sp-3);
    max-width: var(--maxw-text);
  }
  .tip {
    margin: 0;
    font-size: var(--fs-18);
    font-style: italic;
    color: var(--c-text-dim);
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .tip:global(.swap) {
    opacity: 0;
  }
  .bar {
    height: var(--stroke);
    background: var(--c-line);
  }
  .bar span {
    display: block;
    height: 100%;
    background: var(--c-ember);
    box-shadow: 0 0 8px var(--c-ember-glow);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .skip {
    margin: 0;
    padding-bottom: var(--sp-3);
  }
  @media (max-width: 480px) {
    .loader {
      grid-template-columns: auto 1fr;
    }
    .skip {
      display: none;
    }
  }
</style>
