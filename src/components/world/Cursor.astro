---
/**
 * Gauntlet cursor (Akrem's final cursor pack). Desktop only: (hover: hover) and (pointer: fine);
 * touch devices keep the native behaviour. Persists across view transitions.
 *
 * A small state machine on ONE element: #cursor[data-state] =
 *   idle       open gauntlet
 *   point      over links / buttons / [data-cursor="point"]            → pointing finger
 *   press      pointer down                                              → pointing finger, squeezed
 *   grab       held > 200ms on something grabbable, or a native drag     → closed fist
 *              (holding the button over nothing stays `press`)
 *   grabbable  over [data-cursor="grab"] (card decks, sliders…)          → open grab hand
 *   idling     still for --dur-idle (5s)                                 → flexing fingers (animated)
 *   wait       during a warp                                             → flexing fingers (animated)
 *   text       over text fields: art hidden, native I-beam shown
 * Art and hotspots come from src/data/cursor.ts (generated by `npm run images`).
 */
import { cursors, type CursorImage } from '@/data/cursor';

const byName = (name: string) => {
  const c = cursors.find((x) => x.name === name);
  if (!c) throw new Error(`cursor "${name}" missing from src/data/cursor.ts`);
  return c;
};
// art id → cursor image; states pick an art id in the CSS below
const art: Record<string, CursorImage> = {
  default: byName('default'),
  pointer: byName('pointer'),
  grab: byName('grab'),
  grabbing: byName('grabbing'),
  wait: byName('wait'),
};
const wait = art.wait!;
---

<div
  class="cursor"
  id="cursor"
  data-state="idle"
  aria-hidden="true"
  transition:persist="cursor"
  data-wait={JSON.stringify({
    frames: wait.frames,
    sequence: wait.sequence,
    stepMs: wait.stepMs,
  })}
>
  {
    Object.entries(art).map(([id, c]) => (
      <img
        data-art={id}
        src={c.src}
        srcset={`${c.src} 1x, ${c.src2x} 2x`}
        width="32"
        height="32"
        alt=""
        decoding="async"
        style={`--hx: ${c.hotspot[0]}px; --hy: ${c.hotspot[1]}px`}
      />
    ))
  }
</div>

<script>
  import { durationMs } from '@/lib/tokens';
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');
  const HOLD_MS = 200; // press longer than this on something grabbable = grab
  const GRABBABLE = '[data-cursor="grab"]';

  const INTERACTIVE =
    'a[href], button:not(:disabled), [role="button"], [role="tab"], summary, label, select, ' +
    'input[type="checkbox"], input[type="radio"], input[type="range"], [data-cursor="point"]';
  const TEXT =
    'input:not([type="checkbox"]):not([type="radio"]):not([type="range"]), textarea, [contenteditable="true"]';

  type State = 'idle' | 'point' | 'press' | 'grab' | 'grabbable' | 'idling' | 'wait' | 'text';

  function init() {
    const el = document.getElementById('cursor');
    if (!el || !fine.matches) return;
    // re-applied on every page load: view transitions replace <html> attributes
    document.documentElement.classList.add('has-cursor');
    if (el.dataset.ready) return;
    el.dataset.ready = '1';

    let x = -100;
    let y = -100;
    let raf = 0;
    let target: Element | null = null;
    let down = false;
    let holding = false;
    let warping = false;
    let resting = false; // still for --dur-idle
    let holdTimer = 0;
    let restTimer = 0;

    const hoverState = (): State => {
      if (!target?.isConnected) return 'idle';
      if (target.closest(TEXT)) return 'text';
      if (target.closest(GRABBABLE)) return 'grabbable';
      if (target.closest(INTERACTIVE)) return 'point';
      return 'idle';
    };
    const set = (s: State) => {
      if (el.dataset.state === s) return;
      el.dataset.state = s;
      s === 'wait' || s === 'idling' ? startWait() : stopWait();
    };
    const update = () => {
      const hover = hoverState();
      set(
        warping
          ? 'wait'
          : holding
            ? 'grab'
            : down
              ? 'press'
              : resting && hover !== 'text'
                ? 'idling'
                : hover,
      );
    };
    // any movement or click wakes the gauntlet; stillness for --dur-idle starts the idle fidget
    const wake = () => {
      resting = false;
      clearTimeout(restTimer);
      restTimer = window.setTimeout(() => {
        resting = true;
        update();
      }, durationMs('--dur-idle'));
    };

    // ── flexing animation (wait + idling): swaps the frame, only while shown ──
    const anim = JSON.parse(el.dataset.wait ?? '{}') as {
      frames?: { src: string; src2x: string }[];
      sequence?: number[];
      stepMs?: number;
    };
    const waitImg = el.querySelector<HTMLImageElement>('[data-art="wait"]')!;
    let waitTimer = 0;
    let step = 0;
    function startWait() {
      if (still.matches || !anim.frames?.length || waitTimer) return;
      waitTimer = window.setInterval(() => {
        const seq = anim.sequence ?? anim.frames!.map((_, i) => i);
        step = (step + 1) % seq.length;
        const f = anim.frames![seq[step]!]!;
        waitImg.srcset = `${f.src} 1x, ${f.src2x} 2x`;
        waitImg.src = f.src;
      }, anim.stepMs ?? 100);
    }
    function stopWait() {
      clearInterval(waitTimer);
      waitTimer = 0;
    }
    // warm the cache so the first wait frame swap doesn't flicker
    anim.frames?.forEach((f) => (new Image().src = devicePixelRatio > 1 ? f.src2x : f.src));

    const paint = () => {
      el.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      update();
      raf = 0;
    };
    window.addEventListener(
      'pointermove',
      (e) => {
        x = e.clientX;
        y = e.clientY;
        target = e.target as Element;
        wake();
        if (!raf) raf = requestAnimationFrame(paint);
      },
      { passive: true },
    );
    window.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      down = true;
      wake();
      // only something grabbable turns a long press into a grab
      if ((e.target as Element).closest?.(GRABBABLE))
        holdTimer = window.setTimeout(() => {
          holding = true;
          update();
        }, HOLD_MS);
      update();
    });
    const release = () => {
      clearTimeout(holdTimer);
      down = holding = false;
      update();
    };
    window.addEventListener('pointerup', release);
    window.addEventListener('pointercancel', release);
    window.addEventListener('blur', release);
    document.addEventListener('dragstart', () => {
      holding = true;
      update();
    });
    document.addEventListener('dragend', release);
    document.addEventListener('ff:warp', (e) => {
      warping = (e as CustomEvent).detail === 'start';
      if (!warping) target = null; // the old page's element is gone
      wake();
      update();
    });
    document.addEventListener('mouseleave', () => {
      x = -100;
      y = -100;
      paint();
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .cursor {
    position: fixed;
    left: 0;
    top: 0;
    z-index: var(--z-cursor);
    pointer-events: none;
    display: none;
    transform: translate3d(-100px, -100px, 0);
  }
  .cursor img {
    position: absolute;
    left: 0;
    top: 0;
    display: none;
    max-width: none;
    transform: translate(calc(-1 * var(--hx)), calc(-1 * var(--hy)));
    transform-origin: var(--hx) var(--hy);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  /* state → art */
  .cursor[data-state='idle'] [data-art='default'],
  .cursor[data-state='point'] [data-art='pointer'],
  .cursor[data-state='press'] [data-art='pointer'],
  .cursor[data-state='grab'] [data-art='grabbing'],
  .cursor[data-state='grabbable'] [data-art='grab'],
  .cursor[data-state='idling'] [data-art='wait'],
  .cursor[data-state='wait'] [data-art='wait'] {
    display: block;
  }
  .cursor[data-state='press'] [data-art='pointer'] {
    transform: translate(calc(-1 * var(--hx)), calc(-1 * var(--hy))) scale(0.88);
  }
  @media (hover: hover) and (pointer: fine) {
    .cursor {
      display: block;
    }
    :global(html.has-cursor),
    :global(html.has-cursor *) {
      cursor: none !important;
    }
    :global(html.has-cursor)
      :global(
        :is(
          input:not([type='checkbox'], [type='radio'], [type='range']),
          textarea,
          [contenteditable='true']
        )
      ) {
      cursor: text !important;
    }
  }
</style>
