---
/**
 * Game-style key prompt, like Lies of P's "[ESC] Close".
 * Display only; the actual key handling lives with the feature that owns it.
 * Hidden on touch devices (no keyboard to press).
 */
interface Props {
  keys: string[]; // e.g. ['Q', 'E'] or ['ESC']
  label: string;
}
const { keys, label } = Astro.props;
---

<span class="kp">
  {keys.map((k) => <kbd>{k}</kbd>)}
  <span class="kp-label">{label}</span>
</span>

<style>
  .kp {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--c-text-dim);
    font-size: var(--fs-16);
  }
  kbd {
    display: inline-grid;
    place-items: center;
    min-width: 28px;
    height: 26px;
    padding: 0 6px;
    font-family: var(--font-body);
    font-size: var(--fs-14);
    font-weight: 500;
    color: var(--c-bone);
    border: var(--stroke) solid var(--c-text-faint);
    box-shadow:
      inset 0 0 0 2px var(--c-void),
      inset 0 0 0 3px var(--c-stone);
  }
  .kp-label {
    font-family: var(--font-body);
  }
  @media (hover: none) {
    .kp {
      display: none;
    }
  }
</style>
