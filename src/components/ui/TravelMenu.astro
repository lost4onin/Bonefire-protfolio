---
/**
 * Travel menu: every bonfire with its in-world name, plain label and one line of lore.
 * Used inline on the landing (real HTML nav, works without JS) and as a modal <dialog> in
 * WorldLayout (opened by `M`, the header Travel button, or anything with [data-travel-open]).
 *
 * Keyboard: ↑/↓ (and Home/End) move between places, Enter goes, ESC closes the dialog.
 * The native dialog gives the focus trap and ESC; focus goes back to whatever opened it.
 * Phones: the dialog becomes a bottom sheet.
 */
import { bonfires } from '@/data/site';
import TextBox from './TextBox.astro';
import KeyPrompt from './KeyPrompt.astro';

interface Props {
  variant?: 'inline' | 'modal';
  /** path of the current page, marked "You are here" */
  current?: string;
  class?: string;
}
const { variant = 'inline', current = Astro.url.pathname, class: className } = Astro.props;
const here = current.replace(/\/+$/, '') || '/';
const isHere = (href: string) =>
  href === '/' ? here === '/' : here === href || here.startsWith(href + '/');
const headingId = variant === 'modal' ? 'travel-dialog-title' : 'travel-inline-title';
---

{
  variant === 'modal' ? (
    <dialog id="travel-dialog" class="travel-dialog" aria-labelledby={headingId}>
      <TextBox width="full" class="travel-box">
        <div class="head">
          <h2 id={headingId} class="title">
            Travel
          </h2>
          <button type="button" class="close" data-travel-close>
            <KeyPrompt keys={['ESC']} label="Close" />
            <span class="close-touch">Close</span>
          </button>
        </div>
        <ul class="list" data-travel-list>
          {bonfires.map((b) => (
            <li>
              <a href={b.href} aria-current={isHere(b.href) ? 'page' : undefined}>
                <span class="row">
                  <span class="name">{b.name}</span>
                  <span class="section">{b.section}</span>
                </span>
                <span class="lore">{isHere(b.href) ? 'You are here.' : b.lore}</span>
              </a>
            </li>
          ))}
        </ul>
      </TextBox>
    </dialog>
  ) : (
    <TextBox as="nav" width="sm" aria-labelledby={headingId} class:list={['travel-box', className]}>
      <div class="head">
        <h2 id={headingId} class="title">
          Travel
        </h2>
      </div>
      <ul class="list" data-travel-list>
        {bonfires
          .filter((b) => !isHere(b.href))
          .map((b) => (
            <li>
              <a href={b.href}>
                <span class="row">
                  <span class="name">{b.name}</span>
                  <span class="section">{b.section}</span>
                </span>
                <span class="lore">{b.lore}</span>
              </a>
            </li>
          ))}
      </ul>
    </TextBox>
  )
}

<script>
  const isTyping = (el: EventTarget | null) =>
    el instanceof HTMLElement &&
    (el.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(el.tagName));

  let returnFocus: HTMLElement | null = null;
  const dialog = () => document.getElementById('travel-dialog') as HTMLDialogElement | null;

  function open() {
    const d = dialog();
    if (!d || d.open) return;
    returnFocus = document.activeElement as HTMLElement | null;
    d.showModal();
    const links = [...d.querySelectorAll<HTMLAnchorElement>('[data-travel-list] a')];
    (links.find((a) => a.getAttribute('aria-current') !== 'page') ?? links[0])?.focus();
  }
  function close() {
    dialog()?.close();
  }

  // Everything is delegated on `document`, which survives view transitions: bind once.
  if (!window.__travelBound) {
    window.__travelBound = true;

    document.addEventListener('keydown', (e) => {
      if (e.defaultPrevented || e.ctrlKey || e.metaKey || e.altKey || isTyping(e.target)) return;

      if (e.key === 'm' || e.key === 'M') {
        e.preventDefault();
        dialog()?.open ? close() : open();
        return;
      }

      const list = (e.target as HTMLElement).closest?.('[data-travel-list]');
      if (!list || !['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(e.key)) return;
      const links = [...list.querySelectorAll<HTMLAnchorElement>('a')];
      const i = links.indexOf(e.target as HTMLAnchorElement);
      const next =
        e.key === 'Home'
          ? 0
          : e.key === 'End'
            ? links.length - 1
            : (i + (e.key === 'ArrowDown' ? 1 : -1) + links.length) % links.length;
      e.preventDefault();
      links[next]?.focus();
    });

    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-travel-open]')) open();
      else if (t.closest('[data-travel-close]')) close();
      else if (t === dialog()) close(); // click on the backdrop
    });

    // The dialog sits in the top layer, above the warp veil: close it before travelling.
    document.addEventListener('astro:before-preparation', close);

    document.addEventListener(
      'close',
      (e) => {
        if (e.target !== dialog()) return;
        if (returnFocus?.isConnected) returnFocus.focus();
        returnFocus = null;
      },
      true,
    );
  }
</script>

<style>
  .travel-dialog {
    width: min(100% - 2 * var(--gutter), 480px);
    max-width: none;
    max-height: min(85dvh, 720px);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--c-text);
    overflow: visible;
  }
  .travel-dialog::backdrop {
    background: var(--c-scrim);
  }
  .travel-dialog[open] {
    animation: rise var(--dur-base) var(--ease-out);
  }
  .travel-box {
    padding: var(--sp-4) 0 var(--sp-2);
  }
  .travel-dialog .travel-box {
    max-height: inherit;
    overflow-y: auto;
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: 0 var(--sp-5) var(--sp-3);
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-16);
    font-weight: normal;
    letter-spacing: var(--tracking-label);
    color: var(--c-bone);
  }
  .close {
    min-height: var(--target);
    padding: 0 var(--sp-2);
    border: 0;
    background: transparent;
    color: var(--c-text-dim);
    font: inherit;
    font-size: var(--fs-16);
    cursor: pointer;
  }
  .close:hover {
    color: var(--c-bone);
  }
  .close-touch {
    display: none;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list a {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    min-height: 56px;
    padding: var(--sp-3) var(--sp-5);
    border-top: var(--stroke) solid var(--c-line);
    color: var(--c-bone);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .list a:hover,
  .list a:focus-visible {
    background: rgb(232 168 102 / 0.08);
  }
  .list a[aria-current='page'] .name {
    color: var(--c-ember);
  }
  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
  }
  .name {
    font-family: var(--font-display);
    font-size: var(--fs-18);
    letter-spacing: 0.06em;
  }
  .section {
    font-size: var(--fs-16);
    color: var(--c-text-dim);
  }
  .lore {
    font-size: var(--fs-16);
    font-style: italic;
    color: var(--c-text-dim);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(var(--sp-4));
    }
  }

  /* Phones: bottom sheet */
  @media (max-width: 720px) {
    .travel-dialog {
      width: 100%;
      margin: auto 0 0;
      max-height: 85dvh;
    }
    .travel-dialog[open] {
      animation-name: sheet;
    }
    .travel-dialog .travel-box {
      padding-bottom: max(var(--sp-4), env(safe-area-inset-bottom));
    }
  }
  @media (hover: none), (pointer: coarse) {
    .close-touch {
      display: inline;
    }
  }
  @keyframes sheet {
    from {
      transform: translateY(100%);
    }
  }
</style>
