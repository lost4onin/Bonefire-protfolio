---
/**
 * WorldLayout — every in-game page (/, /about, /works, /victories, /armoury, /contact, /404).
 * Provides: atmosphere (fog/grain/vignette), cursor, header (identity + Travel + Skip the journey),
 * footer (seeking status + key prompts + email + CV + credits), main landmark, Travel dialog (`M`),
 * loading screen (only shown when a page calls window.__loader.expect()).
 *
 * Recruiter rule: name, role and "Skip the journey" (→ /cv) head EVERY world page; email and CV
 * close it in the footer, at the very end of the page (Akrem, 2026-10-29).
 *
 * Slots:
 *  - default     → page content (inside <main>)
 *  - "scene"     → full-bleed background layer (3D canvas, art) behind content
 *  - "prompts"   → extra <KeyPrompt>s for this page (ESC/M are always present)
 */
import BaseLayout from './BaseLayout.astro';
import Fog from '@/components/world/Fog.astro';
import Cursor from '@/components/world/Cursor.astro';
import KeyPrompt from '@/components/ui/KeyPrompt.astro';
import TravelMenu from '@/components/ui/TravelMenu.astro';
import Loader from '@/components/world/Loader.astro';
import { site, recruiterRoute } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  fog?: 'light' | 'normal' | 'thick';
  noindex?: boolean;
  /** hide header/footer chrome (e.g. landing intro before "Rest"). Content stays in the DOM. */
  quietChrome?: boolean;
}
const { title, description, fog = 'normal', noindex, quietChrome = false } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <slot name="head" slot="head" />
  <a class="skip-link" href="#main">Skip to content</a>

  <!-- scene under the CSS fog, grain and vignette so they also grade the 3D canvas -->
  <div class="scene-layer"><slot name="scene" /></div>
  <Fog density={fog} />

  <div class="world">
    <header class:list={['chrome', 'top', { quiet: quietChrome }]}>
      <a class="id" href="/" aria-label={`${site.name}, home`}>
        <span class="id-name">{site.name}</span>
        <span class="id-role">{site.role}</span>
      </a>
      <nav aria-label="Shortcuts" class="shortcuts">
        <button
          type="button"
          class="travel-open"
          data-travel-open
          aria-haspopup="dialog"
          aria-controls="travel-dialog">Travel</button
        >
        <a class="skip-journey" href={recruiterRoute.href}>{recruiterRoute.label} →</a>
      </nav>
    </header>

    <main id="main" class="content">
      <slot />
    </main>

    <footer class:list={['chrome', 'bottom', { quiet: quietChrome }]}>
      <p class="status">
        <span class="dot" aria-hidden="true"></span>
        {site.seeking}
      </p>
      <div class="prompts">
        <slot name="prompts" />
        <KeyPrompt keys={['M']} label="Travel" />
      </div>
      <p class="contact">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <span aria-hidden="true">·</span>
        <a href={site.links.cv} download>CV (PDF)</a>
        <span aria-hidden="true">·</span>
        <a href="/credits">Credits</a>
      </p>
    </footer>
  </div>

  <TravelMenu variant="modal" />
  <Loader />
  <Cursor />
</BaseLayout>

<style>
  .scene-layer {
    position: fixed;
    inset: 0;
    z-index: var(--z-world);
  }
  /* header · main · footer, all in the flow, and see-through: they float in Fog's edge shadow, so
     no bar ever cuts the scene. The header is pinned (sticky) on desktop and scrolls away on phones.
     The footer is never pinned: it closes the page and rises into place as you reach the end. */
  .world {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }
  .content {
    position: relative;
    z-index: var(--z-content);
    flex: 1;
    /* glows and art may spill past the edge visually, but must never widen the page on phones */
    overflow-x: clip;
    padding: var(--sp-6) var(--gutter) var(--sp-7);
  }
  .chrome {
    position: relative;
    z-index: var(--z-chrome);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3) var(--sp-5);
    padding: var(--sp-5) var(--gutter);
    transition: opacity var(--dur-fade) var(--ease-out);
  }
  .chrome.quiet {
    opacity: 0.35;
  }
  .chrome.quiet:hover,
  .chrome.quiet:focus-within {
    opacity: 1;
  }
  .top {
    position: sticky;
    top: 0;
  }
  /* frosted scrim so text scrolling under the header stays out of its way. It fades in over the
     first scroll step and fades out at its lower edge, so it never draws a line of its own */
  .top::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--c-shade) 55%, transparent);
    -webkit-backdrop-filter: blur(var(--blur-scrim));
    backdrop-filter: blur(var(--blur-scrim));
    -webkit-mask-image: linear-gradient(var(--c-void) 55%, transparent);
    mask-image: linear-gradient(var(--c-void) 55%, transparent);
    pointer-events: none;
  }
  /* where scroll timelines exist the scrim is off until the page scrolls (and on pages that can't),
     so nothing is blurred for nothing, e.g. over the 3D landing */
  @supports (animation-timeline: scroll()) {
    .top::before {
      opacity: 0;
      animation: scrim-in linear both;
      animation-timeline: scroll(root);
      animation-range: 0 var(--sp-6);
    }
  }
  .bottom {
    font-size: var(--fs-16);
    color: var(--c-text-dim);
  }
  /* an engraved hairline that fades out at both ends instead of a bar edge across the screen */
  .bottom::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--gutter);
    right: var(--gutter);
    height: var(--stroke);
    background: var(--c-line-strong);
    -webkit-mask-image: linear-gradient(90deg, transparent, var(--c-void) 30% 70%, transparent);
    mask-image: linear-gradient(90deg, transparent, var(--c-void) 30% 70%, transparent);
  }
  /* rises into place: while the footer scrolls into view its contents trail below, catch up and
     stop exactly at the end of the page. Clipped, so it never lengthens the page */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .bottom {
        overflow: clip;
        view-timeline: --footer block;
      }
      .bottom > * {
        animation: footer-rise linear both;
        animation-timeline: --footer;
        animation-range: entry 0% entry 100%;
      }
    }
  }
  .id {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    min-height: var(--target);
    justify-content: center;
  }
  .id-name {
    font-family: var(--font-display);
    font-size: var(--fs-20);
    letter-spacing: var(--tracking-label);
    color: var(--c-bone);
  }
  .id-role {
    font-style: italic;
    font-size: var(--fs-16);
    color: var(--c-text-dim);
  }
  .shortcuts {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
  }
  .travel-open {
    min-height: var(--target);
    padding: 0 var(--sp-3);
    border: var(--stroke) solid var(--c-line-strong);
    background: transparent;
    font-family: var(--font-display);
    font-size: var(--fs-16);
    letter-spacing: var(--tracking-display);
    color: var(--c-bone);
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .travel-open:hover,
  .travel-open:focus-visible {
    border-color: var(--c-ember);
  }
  .skip-journey {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    font-family: var(--font-display);
    font-size: var(--fs-16);
    letter-spacing: var(--tracking-display);
    color: var(--c-ember);
    text-decoration: none;
  }
  .skip-journey:hover {
    color: var(--c-bone);
  }
  .status {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c-ember);
    box-shadow: 0 0 8px var(--c-ember);
    animation: pulse 1.2s ease-in-out infinite alternate;
  }
  .prompts {
    display: flex;
    gap: var(--sp-5);
  }
  .contact {
    display: flex;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }
  .contact a {
    color: var(--c-text-dim);
    min-height: var(--target);
    display: inline-flex;
    align-items: center;
  }
  .contact a:hover {
    color: var(--c-bone);
  }
  @keyframes pulse {
    from {
      opacity: 0.6;
    }
    to {
      opacity: 1;
    }
  }
  /* keyframe names are global across the site's CSS: keep them unique */
  @keyframes scrim-in {
    to {
      opacity: 1;
    }
  }
  @keyframes footer-rise {
    from {
      opacity: 0;
      transform: translateY(var(--sp-8));
    }
  }
  @media (max-width: 720px) {
    .prompts {
      display: none;
    }
    .top {
      position: relative;
    }
    .top::before {
      display: none;
    }
    .top,
    .bottom {
      padding-top: var(--sp-3);
      padding-bottom: var(--sp-3);
    }
    /* compact footer: status line, then email · CV · Credits on one row */
    .bottom {
      gap: 0 var(--sp-4);
    }
    .contact {
      gap: 0 var(--sp-3);
      font-size: var(--fs-14);
    }
    .contact [aria-hidden='true'] {
      display: none;
    }
  }
</style>
