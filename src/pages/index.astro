---
/**
 * The First Flame — landing.
 * Intro (M2): "A lone flame burns…" → Rest at the flame → "Flame Rekindled" → Travel menu.
 * Plays once per visitor (localStorage `ff.introSeen`); returning visitors get the menu directly.
 * States on #landing[data-intro]: static (no JS: text + menu) · intro · kindled · menu.
 * M3: the 3D bonfire (Scene3D, background) is framed onto [data-hearth]; the 2D bonfire inside it
 * shows until the first 3D frame, and stays as the fallback (no WebGL, reduced motion, Save-Data…).
 */
import WorldLayout from '@/layouts/WorldLayout.astro';
import Bonfire2D from '@/components/world/Bonfire2D.astro';
import TextBox from '@/components/ui/TextBox.astro';
import RuneButton from '@/components/ui/RuneButton.astro';
import TravelMenu from '@/components/ui/TravelMenu.astro';
import Scene3D from '@/components/three/Scene3D.astro';
import { intro } from '@/data/site';
---

<WorldLayout fog="light">
  <Scene3D slot="scene" />
  <div class="stage" id="landing" data-intro="static" data-rekindled={intro.rekindled}>
    <script is:inline data-astro-rerun>
      (function () {
        var seen = false;
        try {
          seen = localStorage.getItem('ff.introSeen') === '1';
        } catch (e) {}
        document.getElementById('landing').dataset.intro = seen ? 'menu' : 'intro';
      })();
    </script>
    <h1 class="sr-only">The First Flame</h1>
    <div class="hearth" data-hearth>
      <Bonfire2D size={240} />
    </div>

    <TextBox as="section" width="md" class="intro" aria-label="Welcome">
      <p>{intro.line}</p>
      <RuneButton class="rest" data-rest>{intro.action}</RuneButton>
    </TextBox>

    <p class="rekindled" role="status"></p>

    <TravelMenu variant="inline" class="menu" />
  </div>
</WorldLayout>

<script>
  import { durationMs } from '@/lib/tokens';

  function init() {
    const root = document.getElementById('landing');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';

    root.querySelector('[data-rest]')?.addEventListener('click', () => {
      root.dataset.intro = 'kindled';
      root.querySelector('.rekindled')!.textContent = root.dataset.rekindled ?? '';
      try {
        localStorage.setItem('ff.introSeen', '1');
      } catch {
        /* private mode: the intro simply plays again next time */
      }
      setTimeout(() => {
        if (!root.isConnected) return;
        root.dataset.intro = 'menu';
        root.querySelector<HTMLAnchorElement>('.menu a')?.focus();
      }, durationMs('--dur-banner'));
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-6);
    padding-top: var(--sp-6);
  }
  .hearth > :global(*) {
    transition: opacity var(--dur-fade) var(--ease-in-out);
  }
  .hearth[data-live] > :global(*) {
    opacity: 0;
  }
  .rekindled {
    display: none;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(var(--fs-24), 5vw, var(--fs-40));
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-align: center;
    color: var(--c-ember);
    text-shadow: 0 0 18px var(--c-ember-glow);
  }

  /* static (no JS): intro text + menu, no button that does nothing */
  .stage[data-intro='static'] :global(.rest) {
    display: none;
  }
  .stage[data-intro='intro'] :global(.menu) {
    display: none;
  }
  .stage[data-intro='kindled'] :global(.intro),
  .stage[data-intro='kindled'] :global(.menu) {
    display: none;
  }
  .stage[data-intro='kindled'] .rekindled {
    display: block;
    animation: kindle var(--dur-banner) var(--ease-out) both;
  }
  .stage[data-intro='menu'] :global(.intro) {
    display: none;
  }
  .stage[data-intro='menu'] :global(.menu) {
    animation: appear var(--dur-base) var(--ease-out);
  }

  .stage :global(.rest) {
    margin-top: var(--sp-5);
  }
  @keyframes kindle {
    0% {
      opacity: 0;
      letter-spacing: var(--tracking-display);
    }
    25%,
    80% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      letter-spacing: var(--tracking-label);
    }
  }
  @keyframes appear {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stage[data-intro='kindled'] .rekindled {
      animation: none;
    }
  }
</style>
