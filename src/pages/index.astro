---
/**
 * The First Flame — landing.
 * Intro (M2): "A lone flame burns…" → Rest at the flame → "Flame Rekindled" → Travel menu.
 * Plays once per visitor (localStorage `ff.introSeen`); returning visitors get the menu directly.
 * States on #landing[data-intro]: static (no JS: text + menu) · intro · kindled · menu.
 * M3: the 3D bonfire (Scene3D, background) is framed onto [data-hearth]. Inside it, a still of that
 * same 3D fire (`npm run still`) shows from the first paint until the live scene has faded in, and
 * stays for good where there is no 3D (no WebGL, reduced motion, Save-Data…). No 2D bonfire here.
 */
import WorldLayout from '@/layouts/WorldLayout.astro';
import TextBox from '@/components/ui/TextBox.astro';
import RuneButton from '@/components/ui/RuneButton.astro';
import TravelMenu from '@/components/ui/TravelMenu.astro';
import Scene3D from '@/components/three/Scene3D.astro';
import { intro, bonfireStill } from '@/data/site';
---

<WorldLayout fog="light">
  <Scene3D slot="scene" />
  <div class="stage" id="landing" data-intro="static" data-rekindled={intro.rekindled}>
    <script is:inline data-astro-rerun>
      (function () {
        var seen = false;
        try {
          seen = localStorage.getItem('ff.introSeen') === '1';
        } catch (e) {}
        document.getElementById('landing').dataset.intro = seen ? 'menu' : 'intro';
      })();
    </script>
    <h1 class="sr-only">The First Flame</h1>
    <div class="hearth" data-hearth>
      <img
        class="still"
        data-still
        src={bonfireStill.src}
        width={bonfireStill.width}
        height={bonfireStill.height}
        alt={bonfireStill.alt}
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <TextBox as="section" width="md" class="intro" aria-label="Welcome">
      <p>{intro.line}</p>
      <RuneButton class="rest" data-rest>{intro.action}</RuneButton>
    </TextBox>

    <p class="rekindled" role="status"></p>

    <TravelMenu variant="inline" class="menu" />
  </div>
</WorldLayout>

<script>
  import { durationMs } from '@/lib/tokens';

  function init() {
    const root = document.getElementById('landing');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';

    root.querySelector('[data-rest]')?.addEventListener('click', () => {
      root.dataset.intro = 'kindled';
      root.querySelector('.rekindled')!.textContent = root.dataset.rekindled ?? '';
      try {
        localStorage.setItem('ff.introSeen', '1');
      } catch {
        /* private mode: the intro simply plays again next time */
      }
      setTimeout(() => {
        if (!root.isConnected) return;
        root.dataset.intro = 'menu';
        root.querySelector<HTMLAnchorElement>('.menu a')?.focus();
      }, durationMs('--dur-banner'));
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-6);
    padding-top: var(--sp-6);
  }
  /* the box the 3D camera frames the fire onto (BonfireScene): its size sets the scene's scale */
  .hearth {
    position: relative;
    width: 15rem;
    aspect-ratio: 8 / 9;
  }
  /* a frame of the 3D fire, feathered into the dark. `npm run still` crops exactly this box, so
     moving or resizing it here (then re-running the script) is all a new crop needs */
  .still {
    position: absolute;
    left: -60%;
    top: -50%;
    width: 220%;
    height: 175%;
    max-width: none;
    object-fit: cover;
    /* centred on the flames, so the stone ring stays solid and the rising embers fade out */
    -webkit-mask-image: radial-gradient(50% 46% at 50% 56%, var(--c-void) 60%, transparent);
    mask-image: radial-gradient(50% 46% at 50% 56%, var(--c-void) 60%, transparent);
    transition: opacity var(--dur-fade) var(--ease-in-out);
  }
  /* the live scene fades in under the still first, then the still fades away: no dip in the light */
  .hearth[data-live] .still {
    opacity: 0;
    transition-delay: var(--dur-fade);
  }
  .rekindled {
    display: none;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(var(--fs-24), 5vw, var(--fs-40));
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-align: center;
    color: var(--c-ember);
    text-shadow: 0 0 18px var(--c-ember-glow);
  }

  /* static (no JS): intro text + menu, no button that does nothing */
  .stage[data-intro='static'] :global(.rest) {
    display: none;
  }
  .stage[data-intro='intro'] :global(.menu) {
    display: none;
  }
  .stage[data-intro='kindled'] :global(.intro),
  .stage[data-intro='kindled'] :global(.menu) {
    display: none;
  }
  .stage[data-intro='kindled'] .rekindled {
    display: block;
    animation: kindle var(--dur-banner) var(--ease-out) both;
  }
  .stage[data-intro='menu'] :global(.intro) {
    display: none;
  }
  .stage[data-intro='menu'] :global(.menu) {
    animation: appear var(--dur-base) var(--ease-out);
  }

  .stage :global(.rest) {
    margin-top: var(--sp-5);
  }
  @keyframes kindle {
    0% {
      opacity: 0;
      letter-spacing: var(--tracking-display);
    }
    25%,
    80% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      letter-spacing: var(--tracking-label);
    }
  }
  @keyframes appear {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stage[data-intro='kindled'] .rekindled {
      animation: none;
    }
  }
</style>
