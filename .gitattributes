# Order matters: later lines override earlier ones for the same attribute.

# 1. Text normalisation
* text=auto eol=lf

# 2. Web-ready binaries (public/, src/): plain git, never normalised or diffed as text
*.glb  binary
*.webp binary
*.png  binary
*.ogg  binary
*.mp3  binary

# 3. Raw source binaries go through Git LFS, but ONLY under assets-src/.
#    Vercel does not fetch LFS objects, so anything it serves (public/, src/) must be a normal file.
#    One-time setup on your machine:  git lfs install
assets-src/**/*.glb   filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.gltf  filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.fbx   filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.obj   filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.blend filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.wav   filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.mp3   filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.ogg   filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.psd   filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.ktx2  filter=lfs diff=lfs merge=lfs -text
